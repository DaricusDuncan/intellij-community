<idea-plugin>
    <id>com.agentjar</id>
    <name>AgentJar</name>
    <vendor email="support@agentjar.com" url="https://agentjar.com">AgentJar</vendor>

    <description><![CDATA[
    AgentJar: An agentic Spring Boot IDE built on the IntelliJ Platform.
    Features agent-driven code generation, Spring Boot scaffolding, conventional commits, and Docker integration.
    ]]></description>

    <idea-version since-build="242"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="AgentJar" anchor="right" factoryClass="com.agentjar.AgentJarToolWindowFactory"/>
    </extensions>

    <actions>
        <group id="AgentJar.ActionGroup" text="AgentJar" description="AgentJar actions">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="AgentJar.OpenChat" class="com.agentjar.actions.OpenAgentChatAction"
                    text="Open Agent Chat" description="Open the AgentJar chat interface"/>
            <action id="AgentJar.ScaffoldSpringBoot" class="com.agentjar.actions.ScaffoldSpringBootAction"
                    text="Scaffold Spring Boot" description="Scaffold a basic Spring Boot application"/>
            <action id="AgentJar.ConventionalCommit" class="com.agentjar.actions.ConventionalCommitAction"
                    text="Conventional Commit" description="Create a conventional commit"/>
        </group>
    </actions>
</idea-plugin>
